<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  The app target generates its Info.plist from build settings (GENERATE_INFOPLIST_FILE);
  Xcode merges this partial plist into it (INFOPLIST_FILE). Only keys that cannot be
  expressed as an INFOPLIST_KEY_ build setting belong here, which today is the exported
  type, the document type built on it and the iCloud container dictionary. Version, bundle
  identifier, the iOS scene/launch keys, and the iOS-only document browser, open-in-place
  and display name keys stay in build settings (the last three per SDK, so the Mac's plist
  never carries them). This file lives outside "LSVR CineSched/" on purpose: that folder
  is a synchronized group and anything in it is copied into the bundle as a resource,
  which collides with the generated plist in the flat iOS bundle (see CLAUDE.md).

  Only the native type is a document type (ADR 0005): it is what Finder and the Files app
  associate with the app. The second exported type, com.lsvr.cinesched.drag-payload, is
  what a drag on the schedule carries (ScheduleDrag.swift, #18): an in-app blob conforming
  to public.data, with no extension, so nothing on disk is ever of that type. The third,
  com.lsvr.cinesched.shot-drag-payload, is the same for a shot sub-row's drag (#42): a type
  of its own so that no scene, day or Boneyard destination is ever offered a shot. Legacy .json opens on the Mac through the project document's
  readable types (a viewer role: the first Save asks for a .cinesched destination); it is
  deliberately not declared here, so that no platform claims every JSON file.

  NSUbiquitousContainers names the iCloud Documents container the iOS, iPadOS and
  visionOS builds own (ADR 0006): public, so it shows in iCloud Drive as the "CineSched"
  folder on every device. The Mac's plist carries it too because the file is shared; a
  plist key grants nothing on its own, and the Mac has no iCloud entitlement, so there it
  is inert. iCloud reads these keys only when the bundle version changes: bump
  CURRENT_PROJECT_VERSION with any edit to them.
-->
<dict>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>CineSched Project</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.lsvr.cinesched.project</string>
			</array>
			<key>CFBundleTypeIconSystemGenerated</key>
			<integer>1</integer>
		</dict>
	</array>
	<key>NSUbiquitousContainers</key>
	<dict>
		<key>iCloud.com.lsvr.LSVR-CineSched</key>
		<dict>
			<key>NSUbiquitousContainerIsDocumentScopePublic</key>
			<true/>
			<key>NSUbiquitousContainerName</key>
			<string>CineSched</string>
			<key>NSUbiquitousContainerSupportedFolderLevels</key>
			<string>Any</string>
		</dict>
	</dict>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.lsvr.cinesched.drag-payload</string>
			<key>UTTypeDescription</key>
			<string>CineSched Drag Payload</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.lsvr.cinesched.shot-drag-payload</string>
			<key>UTTypeDescription</key>
			<string>CineSched Shot Drag Payload</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.lsvr.cinesched.project</string>
			<key>UTTypeDescription</key>
			<string>CineSched Project</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>cinesched</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
